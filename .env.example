# Firebase web config for the VueFire client. Set these in Netlify as well so SSR can
# initialize the app. No service-account private key belongs here.
FIREBASE_APIKEY=
FIREBASE_AUTHDOMAIN=
FIREBASE_PROJECTID=
FIREBASE_STORAGEBUCKET=
FIREBASE_MESSAGINGSENDERID=
FIREBASE_APPID=

# Admin SDK for the __session cookie (httpOnly, secure, SameSite=lax).
# Required when `nuxt build` runs, so POST /api/__session is registered, and again at
# function runtime, so a hard refresh of a gated page stays signed in.
# Local: a path to a gitignored JSON file (sa.json or service-account.json).
# Netlify: the file contents as one line of JSON, not a file path. Do not commit that JSON.
GOOGLE_APPLICATION_CREDENTIALS=

# TMDB. The bearer token stays on the server.
NUXT_API_KEY=
NUXT_API_BASE_URL=
NUXT_API_BEARER_TOKEN=
