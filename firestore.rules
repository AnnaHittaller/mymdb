rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Top-level user profile doc at /users/{uid} — not /users/{uid}/...
    // A rule like match /users/{userId}/{documents=**} does NOT cover this document.
    // list stays closed: an allow read here would open collection queries.
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner();
      allow list: if false;
      allow create: if isOwner();
      allow update: if isOwner();
      allow delete: if isOwner();
    }
  }
}
