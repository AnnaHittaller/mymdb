rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    // Document id must be the signed-in uid. get is enough for the VueFire listener.
    // list stays closed: an allow read here would open collection queries.
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow get: if isOwner();
      allow list: if false;
      allow create: if isOwner();
      allow update: if isOwner();
      allow delete: if isOwner();
    }
  }
}
